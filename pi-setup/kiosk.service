[Unit]
Description=Haven Deck kiosk browser
After=network-online.target haven-deck.service
Wants=network-online.target

[Service]
Type=simple
Environment=HAVEN_DECK_URL=http://127.0.0.1:4173
ExecStart=/usr/local/bin/haven-deck-kiosk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
