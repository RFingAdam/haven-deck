{
  "name": "haven-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DIY touchscreen stream deck for a Raspberry Pi, tablet, or browser.",
  "license": "MIT",
  "author": "Adam Engelbrecht (SwampBewdy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/RFingAdam/haven-deck.git"
  },
  "scripts": {
    "dev": "node scripts/copy-packs.mjs && vite",
    "build": "node scripts/copy-packs.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/kiosk-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src server scripts",
    "scrub": "node scripts/scrub-check.mjs",
    "synth": "python3 scripts/synth-starter.py",
    "ci": "npm run scrub && npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
